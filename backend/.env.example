# Copy this file to `.env` and adjust if needed.
# Ollama runs locally — no API keys required.

OLLAMA_BASE_URL=http://localhost:11434

# The chat model. Pull it first with:  ollama pull llama3.2
LLM_MODEL=llama3.2

# The embedding model. Pull it first with:  ollama pull nomic-embed-text
EMBEDDING_MODEL=nomic-embed-text

# Where the Chroma vector DB is persisted on disk
CHROMA_DIR=./chroma_db

# Where uploaded / sample documents live
DATA_DIR=./data

# RAG tuning knobs (used by the code YOU will write)
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_K=4

# --- Agent track ---
AGENT_MAX_STEPS=6

# Set to true only after you've implemented app/agent/mcp_tools.py AND have
# Node/npx installed. Loads tools from an MCP server (see mcp_tools.py).
MCP_ENABLED=false
